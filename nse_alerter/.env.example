# ── Signal rule ──────────────────────────────────────────────────────────
# STRATEGY = qqe (default: ported "QQE signals" Pine script) | ema20 (the
# original close-vs-EMA20 cross) | both (each with its own dedupe state).
STRATEGY=qqe
# QQE parameters (defaults = the Pine script's inputs; ThreshHold was unused
# in the original script and is therefore not ported):
QQE_RSI_PERIOD=14
QQE_SF=5
QQE_FACTOR=4.238

# Comma list of watches. Forms per entry:
#   NIFTY1!                        bare symbol that's in the built-in table
#   MCX:CRUDEOIL                   exchange:symbol (proxy from built-in table)
#   MCX:CRUDEOIL>BZ=F              fully explicit (yahoo proxy after '>')
# Built-in table: NIFTY1!->NSE/^NSEI · CRUDEOIL->MCX/BZ=F (Brent)
#                 CRUDEOILM->MCX/BZ=F · NATURALGAS->MCX/NG=F (Henry Hub)
# MCX futures ride FREE proxies: TradingView blocks MCX *symbols* for anonymous
# sessions, BUT crude fetches TVC:UKOIL (real-time Brent CFD) via a built-in TV
# override; yahoo BZ=F/NG=F remain the fallback (BZ=F measured +10 min late).
# Default: NIFTY + crude BOTH on Magic Envelope, running EVERY day.
# Rotation: Tue = NIFTY / Thu = SENSEX 0DTE strangle days add a 09:45
# entry alert (BLUE -> sell ATM PE, RED -> sell ATM CE otherwise).
# Entry forms: SYMBOL[~strategy][@HH:MM-HH:MM][>yahoo-proxy], e.g.
#   NIFTY1!  |  MCX:CRUDEOIL~env  |  MCX:CRUDEOIL~env@17:00-22:00>BZ=F
# strategy: qqe | ema20 | both | env (no suffix = follows STRATEGY).
# @window: alert only inside that IST window, Mon-Fri (close + 5 min grace);
# default gates crude to 17:00-22:00 (alerts stop by 22:05).
# NG is off - add MCX:NATURALGAS to re-enable (cloud: repo Variable SYMBOLS
# overrides the workflow default).
SYMBOLS=NIFTY1!~env,MCX:CRUDEOIL~env@17:00-22:00
# Magic Envelope tuning (percent: 0.2 = +/-0.2% band; backtested 5.3 flips/day
# on crude 5m for a month - NIFTY at 0.2 only gives ~0.5/day, tune per symbol):
ENVELOPE_LEN=20
ENVELOPE_PERCENT=0.2
ENVELOPE_EXPONENTIAL=false
# Pre-flip heads-up (env watches): the FORMING bar beyond the band sends a
# one-off ⚠️ "flip PENDING" within one cron tick - BEFORE the confirmed
# full-bar flip. Prep never moves state; a completed bar closing back inside
# the band re-arms the episode. Set false to turn the heads-up off:
PREP_ALERTS=true
INTERVAL=5m                   # 1m|5m|15m|30m|1h|1d   (the rule is 5m)
EMA_LEN=20                    # used by the ema20 strategy
LOOKBACK_BARS=300             # bars fetched per run (indicator warm-up)

# ── Data provider: auto | tv | yahoo | kite ──────────────────────────────
# auto = TradingView futures first, yfinance spot proxy as fallback (recommended)
DATA_PROVIDER=auto

# ── Telegram alerts (v1's only channel) ──────────────────────────────────
# Steps to create both values: see README "Telegram setup"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Zerodha Kite (DATA_PROVIDER=kite leads the chain; the free TV/yahoo chain
#    stays behind it, so a stale daily token degrades instead of darkening
#    alerts - see README §6) ────────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=              # My Apps page (needed by kite_login.py)
KITE_ACCESS_TOKEN=            # rotates daily: python kite_login.py
# Headless auto-login only (python kite_login.py --auto):
#KITE_USER_ID=
#KITE_PASSWORD=
#KITE_TOTP_SECRET=            # base32 secret from your authenticator app

# ── Schedule extras (optional) ───────────────────────────────────────────
# Exchange holidays to skip (comma separated YYYY-MM-DD). Cloud runs carry
# the full 2026 NSE/BSE list as a workflow default - override with the repo
# Variable HOLIDAYS. Weekend dates are redundant (auto-skipped):
#HOLIDAYS=2026-10-02,2026-10-20
# Also append logs to a file (stdout is always used):
#LOG_FILE=nse_alerter.log
#STATE_FILE=C:\somewhere\state.json
