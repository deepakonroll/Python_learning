# ── Signal rule ──────────────────────────────────────────────────────────
SYMBOL=NIFTY1!                # TradingView symbol: NIFTY futures, continuous front-month
YAHOO_SYMBOL=^NSEI            # NSE spot proxy used when TradingView fails (yahoo provider)
INTERVAL=5m                   # 1m|5m|15m|30m|1h|1d   (the rule is 5m)
EMA_LEN=20
LOOKBACK_BARS=300             # bars fetched per run (EMA warm-up)

# ── Data provider: auto | tv | yahoo | kite ──────────────────────────────
# auto = TradingView futures first, yfinance spot proxy as fallback (recommended)
DATA_PROVIDER=auto

# ── Telegram alerts (v1's only channel) ──────────────────────────────────
# Steps to create both values: see README "Telegram setup"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Zerodha Kite (enable later; needs the PAID Kite Connect plan) ────────
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── Schedule extras (optional) ───────────────────────────────────────────
# NSE holidays to skip (comma separated YYYY-MM-DD):
#HOLIDAYS=2026-10-02,2026-11-09
# Also append logs to a file (stdout is always used):
#LOG_FILE=nse_alerter.log
#STATE_FILE=C:\somewhere\state.json
